# Normalize EOL for all files that Git considers text files.
* text=auto

# Godot script & scene files - force LF
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.res text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cfg text eol=lf
*.godot text eol=lf
*.sh text eol=lf

# Binary files - no EOL conversion
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.zip binary
