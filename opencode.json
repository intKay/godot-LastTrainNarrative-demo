{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/*.md"
  ],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": "ask",
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "skill": "allow"
  },
  "mcp": {},
  "watcher": {
    "ignore": [
      ".git/**",
      ".godot/**",
      "imported/**",
      "export/**",
      "build/**",
      "dist/**",
      "node_modules/**"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  }
}
